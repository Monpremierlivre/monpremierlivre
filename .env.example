# Copie ce fichier en ".env" et remplis chaque valeur avec tes vraies clés.
# Ne partage jamais le fichier ".env" rempli publiquement (GitHub, etc.).

# --- Supabase (base de données + comptes clients) ---
# Dashboard Supabase > Project Settings > API
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe (paiement) ---
# Dashboard Stripe > Developers > API keys
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
# Dashboard Stripe > Developers > Webhooks (à créer après le premier test)
STRIPE_WEBHOOK_SECRET=

# --- Brevo (emails transactionnels : confirmation de commande, etc.) ---
# Dashboard Brevo > SMTP & API > API Keys
BREVO_API_KEY=
BREVO_SENDER_EMAIL=monpremierlivre.com@gmail.com

# --- Secrets internes (appelés par des triggers Supabase via pg_net, jamais exposés au client) ---
# Génère une longue chaîne aléatoire pour chacun (ex: openssl rand -hex 24) et mets EXACTEMENT
# la même valeur dans le trigger SQL correspondant (supabase_welcome_discount.sql / supabase_newsletter_products.sql).
WELCOME_WEBHOOK_SECRET=
NEWSLETTER_WEBHOOK_SECRET=
UNSUBSCRIBE_SECRET=
